# 这里是默认值。在界面的「设置」页保存的值（存在 settings.json）会逐项覆盖它们。
ZHIPU_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
EXTRACT_MODEL=glm-4.6v
CLASSIFY_MODEL=glm-4.5-air
# 问答模型。留空则沿用 CLASSIFY_MODEL
ANSWER_MODEL=
# 向量模型：提问时换个说法也能搜到，录入时能发现内容相近的重复笔记。留空则只做字面检索。
# 走同一个接口地址和密钥的 /embeddings 接口
EMBED_MODEL=embedding-3

# 分类、压缩、检索词扩展这类小调用是否关闭模型的思考模式（智谱专有参数，关闭后每次不到 1 秒，
# 开着要 5 秒以上）。换成不认 thinking 参数的服务商时改成 false
DISABLE_THINKING=true
