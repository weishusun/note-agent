# 这里是默认值。在界面的「设置」页保存的值（存在 settings.json）会逐项覆盖它们。
ZHIPU_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
EXTRACT_MODEL=glm-4.6v
CLASSIFY_MODEL=glm-4.5-air
# 问答模型。留空则沿用 CLASSIFY_MODEL
ANSWER_MODEL=

# 分类、压缩、检索词扩展这类小调用是否关闭模型的思考模式（智谱专有参数，关闭后每次不到 1 秒，
# 开着要 5 秒以上）。换成不认 thinking 参数的服务商时改成 false
DISABLE_THINKING=true

# 结构化输出方式：function_calling | json_mode
# GLM 的 OpenAI 兼容接口对两者支持不一。默认 function_calling；
# 第一次撞墙(报不支持 tools / response_format)时改成 json_mode，不用改代码。
STRUCTURED_OUTPUT_METHOD=function_calling
